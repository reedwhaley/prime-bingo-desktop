{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prime Bingo Desktop",
  "version": "0.3.0",
  "identifier": "com.wcrllc.primebingo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:4174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Prime Bingo Desktop",
        "width": 1600,
        "height": 1000,
        "minWidth": 1180,
        "minHeight": 780,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "WCR LLC",
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
